# ==================== 应用配置 ====================
APP_NAME=RAG Knowledge QA
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 关系数据库配置 ====================
# SQLite (开发环境默认)
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# MySQL (生产环境推荐)
# 注意: 需要先手动创建数据库 CREATE DATABASE rag_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/rag_db
# DATABASE_URL=mysql+asyncmy://rag:ragpass@mysql:3306/rag_db

# PostgreSQL (生产环境备选)
# DATABASE_URL=postgresql+asyncpg://rag:ragpass@postgres:5432/ragdb

# ==================== LLM 配置 ====================
# 支持 OpenAI 兼容 API (OpenAI / DeepSeek / Ollama / vLLM 等)
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini
# 本地部署示例 (Ollama):
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ==================== Embedding 配置 ====================
# 方式1: 使用 OpenAI 兼容 API
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 方式2: 使用本地 sentence-transformers (取消注释并安装 FlagEmbedding)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# 方式3: 使用 Ollama embedding
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# ==================== 向量数据库 ====================
# 向量存储类型: numpy (默认, NumPy 本地持久化) 或 milvus (Milvus 向量数据库)
VECTOR_STORE_TYPE=numpy

# NumPy 本地存储路径 (vector_store_type=numpy 时生效)
CHROMA_PERSIST_PATH=./data/chroma
CHROMA_COLLECTION_NAME=knowledge_chunks

# Milvus 配置 (vector_store_type=milvus 时生效)
# 使用 Docker 部署: docker run -d --name milvus-standalone -p 19530:19530 -p 9091:9091 milvusdb/milvus:v2.4.0
# 或使用 docker-compose 中的 milvus 服务
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=knowledge_chunks

# ==================== 文档处理 ====================
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_FILE_SIZE_MB=50

# ==================== 检索配置 ====================
RETRIEVAL_TOP_K=50
RERANK_TOP_K=10
VECTOR_SEARCH_WEIGHT=0.6
BM25_SEARCH_WEIGHT=0.4

# ==================== Reranker 配置 ====================
# 本地 Cross-Encoder 模型 (需安装 sentence-transformers)
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 或使用 API 方式
RERANKER_ENABLED=false

# ==================== Redis 缓存 (可选) ====================
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false
