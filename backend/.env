# ==================== 应用配置 ====================
APP_NAME=RAG Knowledge QA
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 数据库配置 ====================
# 开发环境使用 SQLite，生产环境切换 PostgreSQL
DATABASE_URL=mysql+asyncmy://root:123456@localhost:3306/rag_db
# DATABASE_URL=postgresql+asyncpg://rag:ragpass@postgres:5432/ragdb

# ==================== LLM 配置 ====================
# 支持 OpenAI 兼容 API (OpenAI / DeepSeek / Ollama / vLLM 等)
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-b224e9714d7f4738bbac165877dc97ac
LLM_MODEL=deepseek-chat
# 本地部署示例 (Ollama):
# LLM_API_BASE=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ==================== Embedding 配置 ====================
# 方式1: 使用 OpenAI 兼容 API
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-byeugjtzhbcrjznvetymmfkzmuuywbnhlwgzzfhkkzalombe
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 方式2: 使用本地 sentence-transformers (取消注释并安装 FlagEmbedding)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# 方式3: 使用 Ollama embedding
# EMBEDDING_API_BASE=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIM=1024

# ==================== 向量数据库 ====================
# ChromaDB 本地存储路径
# CHROMA_PERSIST_PATH=./data/chroma
# CHROMA_COLLECTION_NAME=knowledge_chunks

# 生产环境可切换 Milvus (需安装 pymilvus)
VECTOR_STORE_TYPE=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== 文档处理 ====================
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_FILE_SIZE_MB=50

# ==================== 检索配置 ====================
RETRIEVAL_TOP_K=50
RERANK_TOP_K=10
VECTOR_SEARCH_WEIGHT=0.6
BM25_SEARCH_WEIGHT=0.4

# ==================== Reranker 配置 ====================
# 本地 Cross-Encoder 模型 (需安装 sentence-transformers)
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 或使用 API 方式
RERANKER_ENABLED=false

# ==================== Redis 缓存 (可选) ====================
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=false

# ==================== 网络搜索配置 ====================
# 知识库无结果或得分过低时自动搜索网络补充
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
# 知识库最高得分低于此值时触发网络搜索 (0.0-1.0)
WEB_SEARCH_SCORE_THRESHOLD=0.15
